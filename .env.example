# Discord (required)
DISCORD_BOT_TOKEN=

# 추론은 Claude 구독(`claude login`) — API 키 불필요.

# Finance APIs — 무료 키 다중 발급 권장 (CSV 또는 _1/_2/_3 인덱스 형식 모두 지원)
# 미국 주식 시세 (우선순위: Finnhub → Twelve Data → Alpha Vantage)
FINNHUB_KEY=
TWELVE_DATA_KEY=
ALPHA_VANTAGE_KEY=
COINGECKO_API_KEY=

# 영문 뉴스
NEWSDATA_API_KEY=

# 한국투자증권 KIS Open API (read-only 잔고 동기화). 미설정 시 brokerage 기능 비활성.
KIS_ENV=prod              # prod(실전) | vts(모의)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=           # CANO (8자리)
KIS_ACCOUNT_PRODUCT_CODE=01

# Embedding (optional — enables hybrid RAG; without it, FTS-only fallback)
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Gateway (optional)
FINCLAW_API_KEY=
# 빈 값으로 두면 빈 문자열이 secret 이 된다 — 쓸 때만 주석을 풀고 값을 넣는다 (생략 시 'dev-secret').
# GATEWAY_JWT_SECRET=change-me
# GATEWAY_PORT=3000

# Storage (optional) — 빈 값으로 두지 말 것 (생략 시 ~/.finclaw/db.sqlite)
# FINCLAW_DB_PATH=/path/to/db.sqlite
