# Discord (optional — 없으면 Discord 채널만 비활성, Web/TUI/cron 은 동작)
DISCORD_BOT_TOKEN=
# 가격·뉴스 알림 Discord DM 수신자(Discord 사용자 id). DISCORD_BOT_TOKEN 과 함께 있을 때만 새 알림에 discord 채널이 붙는다. 설정하면 예전 ['log','discord'] 알림도 이 id 로 DM 된다.
DISCORD_ALERT_USER_ID=

# 추론은 Claude 구독(`claude login`) — API 키 불필요.

# Finance APIs — 무료 키 다중 발급 권장 (CSV 또는 _1/_2/_3 인덱스 형식 모두 지원)
# 미국 주식 시세 (우선순위: Finnhub → Twelve Data → Alpha Vantage)
FINNHUB_KEY=
TWELVE_DATA_KEY=
ALPHA_VANTAGE_KEY=
COINGECKO_API_KEY=

# 영문 뉴스
NEWSDATA_API_KEY=

# 한국투자증권 KIS Open API (read-only 잔고 동기화). 미설정 시 brokerage 기능 비활성.
KIS_ENV=prod              # prod(실전) | vts(모의)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=           # CANO (8자리)
KIS_ACCOUNT_PRODUCT_CODE=01

# Embedding (optional — enables hybrid RAG; without it, FTS-only fallback)
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Gateway (optional)
FINCLAW_API_KEY=
# 생략 시 ~/.finclaw/gateway.secret 을 자동 생성·재사용(0600). 빈 값도 미설정으로 본다.
# GATEWAY_JWT_SECRET=change-me
# GATEWAY_PORT=3000
# 바인딩 호스트 (기본 127.0.0.1). Docker 는 0.0.0.0.
# GATEWAY_HOST=127.0.0.1

# Storage (optional) — 빈 값으로 두지 말 것 (생략 시 ~/.finclaw/db.sqlite)
# FINCLAW_DB_PATH=/path/to/db.sqlite
