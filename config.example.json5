// config.example.json5 — FinClaw 설정 예시
// ~/.finclaw/config/finclaw.json5 (또는 FINCLAW_CONFIG 경로)로 복사하여 사용하세요.
// 모든 키는 선택이며, 런타임이 실제로 읽는 키만 허용된다 (알 수 없는 키는 부팅 실패).
// 비밀값(Discord 토큰, API 키)은 .env 로 둔다.
{
  // RAG re-ranking (기본 켜짐)
  rag: {
    rerank: { enabled: true, topKFirst: 10 },
  },

  // access-log 보존 기간 (일, 기본 30)
  accessLog: { retentionDays: 30 },

  // `finclaw tui` 가 게이트웨이에 보낼 토큰. ${VAR} 는 환경변수로 치환된다 (미설정 시 부팅 실패).
  // gateway: { auth: { token: '${FINCLAW_GATEWAY_TOKEN}' } },
}
